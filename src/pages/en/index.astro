---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import portraitImg from '../../assets/florian-portrait.jpg';
---

<BaseLayout
  title="Florian Obermeier — Author"
  description="Two books, two poles. Florian Obermeier writes about technology that is changing the world — and about what lies beneath the noise."
  lang="en"
  alternateUrl="/"
>

<style>
  /* HERO */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 6rem 2.5rem 4rem;
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
    overflow: hidden;
  }
  .hero-eyebrow {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: var(--teal);
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .hero-eyebrow::before {
    content: '';
    width: 28px;
    height: 1px;
    background: var(--teal);
  }
  .hero h1 {
    font-family: var(--serif);
    font-size: clamp(2.8rem, 9vw, 6.5rem);
    font-weight: 400;
    color: var(--text-heading);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 2rem;
  }
  .hero h1 .amp {
    font-style: italic;
    color: var(--text-muted);
    font-weight: 400;
    padding: 0 0.1em;
  }
  .hero h1 .stille {
    font-style: italic;
    background: linear-gradient(120deg, var(--gold) 30%, #f5d28e 70%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-sub {
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    color: var(--text);
    max-width: 600px;
    line-height: 1.7;
    margin-bottom: 3rem;
  }
  .hero-sub em {
    font-style: italic;
    color: var(--text-heading);
  }
  .hero-cta {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--text-heading);
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    transition: border-color 0.3s, background 0.3s, transform 0.3s;
    background: rgba(255,255,255,0.02);
  }
  .btn:hover {
    border-color: var(--teal);
    background: rgba(45, 212, 191, 0.08);
    transform: translateY(-1px);
  }
  .btn .arrow { transition: transform 0.3s; }
  .btn:hover .arrow { transform: translateX(3px); }
  .btn--ghost {
    border-color: transparent;
    background: transparent;
    color: var(--text-muted);
  }
  .btn--ghost:hover {
    color: var(--text-heading);
    border-color: var(--line-strong);
    background: transparent;
  }

  .hero-eyebrow,
  .hero h1,
  .hero-sub,
  .hero-cta {
    position: relative;
    z-index: 2;
  }

  /* Portrait — right-side bleed, feathered mask, duotone tint, grain */
  .hero-portrait {
    position: absolute;
    top: 0;
    bottom: 0;
    right: calc(50% - 50vw);
    width: min(720px, 60vw);
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, transparent 16%, rgba(0,0,0,0.32) 36%, rgba(0,0,0,0.78) 58%, #000 76%);
            mask-image: linear-gradient(90deg, transparent 0%, transparent 16%, rgba(0,0,0,0.32) 36%, rgba(0,0,0,0.78) 58%, #000 76%);
  }
  .hero-portrait picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 32%;
    filter: saturate(0.72) contrast(1.06) brightness(0.86);
    transform: scale(1.06);
    transform-origin: 50% 25%;
    display: block;
  }
  .hero-portrait::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(72% 55% at 65% 22%, rgba(232, 169, 72, 0.32), transparent 65%),
      radial-gradient(60% 65% at 32% 80%, rgba(45, 212, 191, 0.18), transparent 70%),
      linear-gradient(180deg, transparent 30%, rgba(10,10,11,0.45) 100%);
    mix-blend-mode: overlay;
    pointer-events: none;
  }
  .hero-portrait-grain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.22;
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  @supports (animation-timeline: scroll()) {
    .hero-portrait img {
      animation: hero-portrait-drift linear both;
      animation-timeline: scroll(root block);
      animation-range: 0 90vh;
    }
    @keyframes hero-portrait-drift {
      from { transform: translateY(-1.5%) scale(1.06); }
      to   { transform: translateY(5%) scale(1.09); }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-portrait img {
      animation: none;
      transform: scale(1.06);
    }
  }

  @media (min-width: 769px) and (max-width: 1023px) {
    .hero-portrait {
      width: min(440px, 48vw);
      opacity: 0.78;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, transparent 26%, rgba(0,0,0,0.28) 48%, rgba(0,0,0,0.72) 70%, #000 86%);
              mask-image: linear-gradient(90deg, transparent 0%, transparent 26%, rgba(0,0,0,0.28) 48%, rgba(0,0,0,0.72) 70%, #000 86%);
    }
  }

  @media (max-width: 768px) {
    .hero { padding: 7rem 1.25rem 3rem; }
    .hero-portrait {
      top: 0; bottom: 0; right: 0;
      width: 100%;
      opacity: 0.32;
      -webkit-mask-image: radial-gradient(82% 65% at 75% 25%, #000 0%, transparent 62%);
              mask-image: radial-gradient(82% 65% at 75% 25%, #000 0%, transparent 62%);
    }
    .hero-portrait img {
      filter: saturate(0.55) contrast(1.05) brightness(0.55) blur(2px);
    }
  }

  /* SECTION SHELL */
  section.block {
    padding: 7rem 2.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .section-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: var(--text-muted);
    margin-bottom: 3rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .section-label::before {
    content: '';
    width: 28px;
    height: 1px;
    background: var(--text-dim);
  }
  @media (max-width: 768px) {
    section.block { padding: 4.5rem 1.25rem; }
    .section-label { margin-bottom: 2rem; }
  }

  /* BOOKS */
  .books-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }
  @media (max-width: 880px) {
    .books-grid { grid-template-columns: 1fr; gap: 3.5rem; }
  }

  .book-card {
    background: var(--bg-card);
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--line);
    transition: border-color 0.5s, transform 0.4s cubic-bezier(.2,.8,.2,1), box-shadow 0.5s;
    position: relative;
  }
  .book-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 18px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s;
    background: radial-gradient(600px circle at var(--mx, 50%) var(--my, 50%), rgba(255,255,255,0.05), transparent 40%);
    z-index: 1;
  }
  .book-card:hover::before { opacity: 1; }
  .book-card--signal:hover { border-color: rgba(45, 212, 191, 0.35); box-shadow: 0 25px 60px -20px rgba(45, 212, 191, 0.18); }
  .book-card--stille:hover { border-color: rgba(232, 169, 72, 0.32); box-shadow: 0 25px 60px -20px rgba(232, 169, 72, 0.18); }

  .cover {
    width: 100%;
    aspect-ratio: 1071 / 1700;
    display: block;
    overflow: hidden;
    position: relative;
    background: #060308;
    line-height: 0;
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s cubic-bezier(.2,.8,.2,1);
  }
  .book-card:hover .cover img { transform: scale(1.03); }

  .release-badge {
    position: absolute;
    top: 1.4rem;
    right: 1.4rem;
    width: 78px;
    height: 78px;
    border-radius: 50%;
    background: var(--gold);
    color: #0a0a0b;
    font-family: var(--sans);
    font-weight: 700;
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    line-height: 1.25;
    transform: rotate(8deg);
    z-index: 3;
    box-shadow: 0 6px 28px rgba(232, 169, 72, 0.5);
    pointer-events: none;
    user-select: none;
  }
  .badge-pre {
    font-size: 0.55rem;
    letter-spacing: 0.14em;
    opacity: 0.75;
  }
  .badge-date {
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }

  .book-info {
    padding: 1.75rem 1.75rem 2rem;
    position: relative;
    z-index: 2;
  }
  .book-tag {
    font-family: var(--mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    margin-bottom: 1rem;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .book-tag::before {
    content: '';
    width: 6px; height: 6px;
    border-radius: 50%;
  }
  .book-tag--signal { color: var(--teal); }
  .book-tag--signal::before { background: var(--teal); box-shadow: 0 0 12px var(--teal); }
  .book-tag--stille { color: var(--gold); }
  .book-tag--stille::before { background: var(--gold); box-shadow: 0 0 12px var(--gold); }

  .book-title {
    font-family: var(--serif);
    font-size: clamp(1.35rem, 2.4vw, 1.7rem);
    color: var(--text-heading);
    margin-bottom: 0.35rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.005em;
  }
  .book-subtitle {
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: 1.4rem;
    line-height: 1.4;
  }
  .book-desc {
    font-size: 0.95rem;
    color: var(--text);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  .book-meta {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: var(--text-dim);
    margin-bottom: 1.75rem;
    border-top: 1px solid var(--line);
    padding-top: 1.25rem;
  }
  .book-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  /* COUNTDOWN */
  .countdown {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
  }
  .countdown-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }
  .countdown-num {
    font-family: var(--mono);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--gold);
    line-height: 1;
    min-width: 2ch;
    text-align: center;
  }
  .countdown-label {
    font-family: var(--mono);
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-dim);
  }
  .countdown-done {
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--gold);
    margin-bottom: 1.75rem;
  }

  /* ABOUT */
  .about {
    max-width: 800px;
  }
  .about-lead {
    font-family: var(--serif);
    font-size: clamp(1.4rem, 2.6vw, 1.95rem);
    color: var(--text-heading);
    line-height: 1.4;
    margin-bottom: 2.5rem;
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  .about-lead em {
    font-style: italic;
    color: var(--gold);
  }
  .about p {
    font-size: 1.02rem;
    color: var(--text);
    line-height: 1.85;
    margin-bottom: 1.5rem;
    max-width: 680px;
  }
  .about p strong {
    color: var(--text-heading);
    font-weight: 500;
  }

  /* NEWSLETTER */
  .newsletter-inner { max-width: 560px; }
  .newsletter-headline {
    font-family: var(--serif);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    color: var(--text-heading);
    font-weight: 400;
    letter-spacing: -0.01em;
    margin-bottom: 0.75rem;
  }
  .newsletter-headline em {
    font-style: italic;
    color: var(--gold);
  }
  .newsletter-sub {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 1.75rem;
    max-width: 480px;
  }
  .newsletter-sub em {
    font-style: italic;
    color: var(--text);
  }
  .nl-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .nl-field {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .nl-input {
    flex: 1;
    min-width: 180px;
    background: var(--bg-card);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 0.85rem 1.25rem;
    color: var(--text-heading);
    font-family: var(--sans);
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.3s;
  }
  .nl-input::placeholder { color: var(--text-dim); }
  .nl-input:focus { border-color: var(--teal); }
  .nl-status {
    margin-top: 0.75rem;
    font-size: 0.88rem;
    min-height: 1.4em;
  }
  .nl-status--ok { color: var(--teal); }
  .nl-status--err { color: #f87171; }

  /* CONTACT */
  .contact {
    text-align: center;
    padding-bottom: 7rem;
  }
  .contact-headline {
    font-family: var(--serif);
    font-size: clamp(2rem, 5vw, 3.5rem);
    color: var(--text-heading);
    line-height: 1.1;
    margin-bottom: 1.5rem;
    font-weight: 400;
    letter-spacing: -0.015em;
  }
  .contact-headline em {
    font-style: italic;
    color: var(--teal);
  }
  .contact-sub {
    color: var(--text-muted);
    max-width: 460px;
    margin: 0 auto 2.5rem;
    font-size: 1.05rem;
  }
  .contact-mail {
    font-family: var(--serif);
    font-size: clamp(1.2rem, 2.4vw, 1.7rem);
    color: var(--text-heading);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 0.35rem;
    transition: border-color 0.3s, color 0.3s;
    letter-spacing: -0.005em;
  }
  .contact-mail:hover {
    border-color: var(--teal);
    color: var(--teal);
  }
  .contact-socials {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-top: 2.5rem;
  }

  /* SOUNDTRACK PRE-LISTEN */
  .soundtrack-block {
    position: relative;
    overflow: hidden;
  }
  .soundtrack-block::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(55% 60% at 50% 50%, var(--gold-glow), transparent 70%);
  }
  .soundtrack-inner {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
    position: relative;
  }
  .audio-block {
    /* container for one player + its meta + note + (optional translation) */
  }
  .audio-divider {
    margin: 3rem auto;
    text-align: center;
    color: var(--text-dim);
    font-size: 0.9rem;
    line-height: 1;
    letter-spacing: 0.6em;
  }
  .audio-divider::after {
    content: '· · ·';
  }
  .soundtrack-meta {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: var(--text-muted);
    margin-bottom: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    flex-wrap: wrap;
  }
  .soundtrack-chapter { color: var(--gold); }
  .soundtrack-sep { color: var(--text-dim); }
  .soundtrack-song {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--text-heading);
    margin-bottom: 2.25rem;
  }

  /* Foreword translation (collapsible, open by default) */
  .foreword-translation {
    margin: 2.5rem auto 0;
    max-width: 580px;
    text-align: left;
    border-top: 1px solid var(--line);
  }
  .foreword-translation > summary {
    list-style: none;
    cursor: pointer;
    padding: 1.25rem 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    transition: color 0.3s;
    color: var(--text-muted);
  }
  .foreword-translation > summary::-webkit-details-marker { display: none; }
  .foreword-translation > summary:hover { color: var(--text); }
  .foreword-translation > summary::before {
    content: '+';
    color: var(--gold);
    font-size: 1.1rem;
    line-height: 1;
    transition: transform 0.3s;
    display: inline-block;
    width: 1ch;
    text-align: center;
  }
  .foreword-translation[open] > summary::before { content: '−'; }
  .ft-summary-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.28em;
  }
  .foreword-translation-text {
    font-family: var(--serif);
    font-size: 1.02rem;
    line-height: 1.85;
    color: var(--text);
    max-width: 58ch;
    margin: 1.5rem auto 1rem;
    padding: 0 0.25rem;
  }
  .foreword-translation-text p { margin-bottom: 1.25em; }
  .foreword-translation-text p:last-child { margin-bottom: 0; }
  .foreword-translation-text em {
    font-style: italic;
    color: var(--text-heading);
  }

  /* Player */
  .player {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1rem 1.25rem 1rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.02);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    max-width: 540px;
    margin: 0 auto 2.5rem;
    transition: border-color 0.4s, background 0.4s;
  }
  .player.is-playing {
    border-color: rgba(232, 169, 72, 0.42);
    background: rgba(232, 169, 72, 0.04);
  }
  .player-btn {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--gold);
    color: var(--bg);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s, box-shadow 0.4s;
    box-shadow: 0 0 0 0 var(--gold-soft);
    padding: 0;
  }
  .player-btn:hover {
    transform: scale(1.04);
    box-shadow: 0 0 0 10px var(--gold-soft);
  }
  .player-btn:active { transform: scale(0.98); }
  .player-btn:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 4px;
  }
  .player-icon {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }
  .player-icon--play { margin-left: 3px; }
  .player-icon--pause { display: none; }
  .player.is-playing .player-icon--play { display: none; }
  .player.is-playing .player-icon--pause { display: block; margin-left: 0; }
  .player-track {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }
  .player-progress {
    height: 4px;
    border-radius: 999px;
    background: var(--line-strong);
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }
  .player-progress:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }
  .player-progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--gold), #f5d28e);
    border-radius: 999px;
    transition: width 0.1s linear;
  }
  .player-time {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }
  .soundtrack-note {
    font-size: 0.92rem;
    color: var(--text-muted);
    max-width: 480px;
    margin: 0 auto;
    line-height: 1.7;
  }
  .soundtrack-note em { font-style: italic; color: var(--text); }

  @media (max-width: 540px) {
    .player {
      flex-direction: column;
      gap: 1rem;
      padding: 1.25rem;
      border-radius: 1.5rem;
    }
    .player-btn { width: 64px; height: 64px; }
    .player-track { width: 100%; }
  }
</style>

<!-- HERO -->
<section class="hero">
  <p class="hero-eyebrow">Florian Obermeier — Author</p>
  <h1>Signal<span class="amp"> &amp; </span><span class="stille">Stille</span></h1>
  <p class="hero-sub">Two books, two poles. One explains a technology that is changing the world. The other searches for <em>what lies beneath</em> — when the noise finally falls silent.</p>
  <div class="hero-cta">
    <a href="#buecher" class="btn">Discover books <span class="arrow">→</span></a>
