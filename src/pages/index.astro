---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import portraitImg from '../assets/florian-portrait.jpg';
---

<BaseLayout
  title="Florian Obermeier — Autor"
  description="Zwei Bücher, zwei Pole. Florian Obermeier schreibt über Technologie, die die Welt verändert — und über das, was unter dem Lärm liegt."
  lang="de"
  alternateUrl="/en/"
>

<style>
  /* HERO */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 6rem 2.5rem 4rem;
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
  }
  .hero-eyebrow {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: var(--teal);
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .hero-eyebrow::before {
    content: '';
    width: 28px;
    height: 1px;
    background: var(--teal);
  }
  .hero h1 {
    font-family: var(--serif);
    font-size: clamp(2.8rem, 9vw, 6.5rem);
    font-weight: 400;
    color: var(--text-heading);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 2rem;
  }
  .hero h1 .amp {
    font-style: italic;
    color: var(--text-muted);
    font-weight: 400;
    padding: 0 0.1em;
  }
  .hero h1 .stille {
    font-style: italic;
    background: linear-gradient(120deg, var(--gold) 30%, #f5d28e 70%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-sub {
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    color: var(--text);
    max-width: 600px;
    line-height: 1.7;
    margin-bottom: 3rem;
  }
  .hero-sub em {
    font-style: italic;
    color: var(--text-heading);
  }
  .hero-cta {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--text-heading);
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    transition: border-color 0.3s, background 0.3s, transform 0.3s;
    background: rgba(255,255,255,0.02);
  }
  .btn:hover {
    border-color: var(--teal);
    background: rgba(45, 212, 191, 0.08);
    transform: translateY(-1px);
  }
  .btn .arrow {
    transition: transform 0.3s;
  }
  .btn:hover .arrow { transform: translateX(3px); }
  .btn--ghost {
    border-color: transparent;
    background: transparent;
    color: var(--text-muted);
  }
  .btn--ghost:hover {
    color: var(--text-heading);
    border-color: var(--line-strong);
    background: transparent;
  }

  .hero-eyebrow,
  .hero h1,
  .hero-sub,
  .hero-cta {
    position: relative;
    z-index: 2;
  }

  /* Portrait — right-side bleed, feathered mask, duotone tint, grain */
  .hero-portrait {
    position: absolute;
    top: 0;
    bottom: 0;
    right: calc(50% - 50vw);
    width: min(720px, 60vw);
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, transparent 16%, rgba(0,0,0,0.32) 36%, rgba(0,0,0,0.78) 58%, #000 76%);
            mask-image: linear-gradient(90deg, transparent 0%, transparent 16%, rgba(0,0,0,0.32) 36%, rgba(0,0,0,0.78) 58%, #000 76%);
  }
  .hero-portrait picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 32%;
    filter: saturate(0.72) contrast(1.06) brightness(0.86);
    transform: scale(1.06);
    transform-origin: 50% 25%;
    display: block;
  }
  .hero-portrait::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(72% 55% at 65% 22%, rgba(232, 169, 72, 0.32), transparent 65%),
      radial-gradient(60% 65% at 32% 80%, rgba(45, 212, 191, 0.18), transparent 70%),
      linear-gradient(180deg, transparent 30%, rgba(10,10,11,0.45) 100%);
    mix-blend-mode: overlay;
    pointer-events: none;
  }
  .hero-portrait-grain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.22;
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  @supports (animation-timeline: scroll()) {
    .hero-portrait img {
      animation: hero-portrait-drift linear both;
      animation-timeline: scroll(root block);
      animation-range: 0 90vh;
    }
    @keyframes hero-portrait-drift {
      from { transform: translateY(-1.5%) scale(1.06); }
      to   { transform: translateY(5%) scale(1.09); }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-portrait img {
      animation: none;
      transform: scale(1.06);
    }
  }

  @media (min-width: 769px) and (max-width: 1023px) {
    .hero-portrait {
      width: min(440px, 48vw);
      opacity: 0.78;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, transparent 26%, rgba(0,0,0,0.28) 48%, rgba(0,0,0,0.72) 70%, #000 86%);
              mask-image: linear-gradient(90deg, transparent 0%, transparent 26%, rgba(0,0,0,0.28) 48%, rgba(0,0,0,0.72) 70%, #000 86%);
    }
  }

  @media (max-width: 768px) {
    .hero { padding: 7rem 1.25rem 3rem; }
    .hero-portrait {
      top: 0; bottom: 0; right: 0;
      width: 100%;
      opacity: 0.32;
      -webkit-mask-image: radial-gradient(82% 65% at 75% 25%, #000 0%, transparent 62%);
              mask-image: radial-gradient(82% 65% at 75% 25%, #000 0%, transparent 62%);
    }
    .hero-portrait img {
      filter: saturate(0.55) contrast(1.05) brightness(0.55) blur(2px);
    }
  }

  /* SECTION SHELL */
  section.block {
    padding: 7rem 2.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .section-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: var(--text-muted);
    margin-bottom: 3rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .section-label::before {
    content: '';
    width: 28px;
    height: 1px;
    background: var(--text-dim);
  }
  @media (max-width: 768px) {
    section.block { padding: 4.5rem 1.25rem; }
    .section-label { margin-bottom: 2rem; }
  }

  /* BOOK SCROLL SCENE */
  .bss-wrap {
    height: 340vh;
    position: relative;
  }
  .bss-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    /* no overflow:hidden — pages rotate left outside book bounds */
  }
  .bss-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(60% 50% at 50% 40%, rgba(232,169,72,0.07), transparent 70%),
      radial-gradient(40% 30% at 50% 60%, rgba(45,212,191,0.05), transparent 70%);
  }
  .bss-stage {
    perspective: 1600px;
    perspective-origin: 50% 48%;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bss-book {
    --pw: clamp(155px, 21vw, 265px);
    --ph: clamp(240px, 33vw, 415px);
    position: relative;
    width: var(--pw);
    height: var(--ph);
    transform-style: preserve-3d;
  }

  /* page thickness strip */
  .bss-thickness {
    position: absolute;
    top: 3px; bottom: 3px; right: -10px;
    width: 10px;
    background: linear-gradient(to right, #b0ab9f, #ede9e0 40%, #e0dbd0 70%, #c8c3b8);
    border-radius: 0 2px 2px 0;
    z-index: 0;
  }

  /* back cover */
  .bss-back {
    position: absolute;
    inset: 0;
    background: linear-gradient(145deg, #120820, #0a0514);
    border-radius: 6px 2px 2px 6px;
    box-shadow: -6px 4px 40px rgba(0,0,0,0.85);
    z-index: 0;
  }

  /* page leaf: rotates around left edge (spine) */
  .bss-page {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform-origin: 0 50%;
  }

  /* front = right page; back = left page content after turning */
  .bss-page-face,
  .bss-page-back {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: clamp(0.85rem, 2vw, 1.1rem) clamp(0.7rem, 1.6vw, 0.95rem);
  }
  .bss-page-face {
    background: #faf8f2;
    border-radius: 2px 6px 6px 2px;
    box-shadow: inset 10px 0 20px rgba(0,0,0,0.06);
  }
  .bss-page-back {
    transform: rotateY(180deg);
    background: #f7f4ee;
    border-radius: 2px 6px 6px 2px;
    box-shadow: inset -10px 0 20px rgba(0,0,0,0.05);
  }

  /* book typography — scaled to match a small page mock-up */
  .bss-chapter-tag {
    font-family: var(--mono);
    font-size: 0.52rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--gold);
    margin-bottom: 0.35rem;
  }
  .bss-text {
    font-family: var(--serif);
    font-size: 0.66rem;
    line-height: 1.75;
    color: #2a2218;
    margin-bottom: 0.5rem;
  }
  .bss-text em { font-style: italic; color: #7a6a50; }
  .bss-page-num {
    margin-top: auto;
    font-family: var(--mono);
    font-size: 0.5rem;
    color: #8a8070;
    text-align: center;
    letter-spacing: 0.1em;
  }
  .bss-song-note {
    margin-top: 0.6rem;
    font-family: var(--mono);
    font-size: 0.5rem;
    letter-spacing: 0.1em;
    color: #8a7060;
  }
  .bss-song-note em { font-style: italic; }

  /* cover */
  .bss-cover {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform-origin: 0 50%;
  }
  .bss-cover-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: 2px 6px 6px 2px;
    overflow: hidden;
    box-shadow: 4px 0 24px rgba(0,0,0,0.6);
  }
  .bss-cover-face img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
  }
  .bss-cover-inner {
    position: absolute;
    inset: 0;
    transform: rotateY(180deg);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    background: #faf8f2;
    border-radius: 2px 6px 6px 2px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
    text-align: center;
  }
  .bss-inner-title {
    font-family: var(--serif);
    font-size: 0.72rem;
    line-height: 1.5;
    color: #1a1510;
    margin-bottom: 0.6rem;
    font-style: italic;
  }
  .bss-inner-rule {
    width: 24px; height: 1px;
    background: #c8a86a;
    margin: 0 auto 0.6rem;
  }
  .bss-inner-author {
    font-family: var(--mono);
    font-size: 0.48rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8a7a60;
  }

  /* meta / CTA */
  .bss-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s ease, transform 0.4s ease;
    text-align: center;
    pointer-events: none;
  }
  .bss-meta.is-visible {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .bss-book-title {
    font-family: var(--serif);
    font-size: clamp(0.95rem, 2vw, 1.35rem);
    color: var(--text-heading);
    font-weight: 400;
    font-style: italic;
    letter-spacing: -0.01em;
  }
  .bss-release-tag {
    font-family: var(--mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--gold);
  }
  .btn--gold {
    border-color: rgba(232,169,72,0.4);
    color: var(--gold);
  }
  .btn--gold:hover {
    border-color: var(--gold);
    background: rgba(232,169,72,0.08);
  }

  /* scroll hint */
  .bss-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-dim);
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    pointer-events: none;
  }
  .bss-hint-arrow {
    width: 1px;
    height: 28px;
    background: linear-gradient(to bottom, var(--text-dim), transparent);
    animation: bss-bounce 1.6s ease-in-out infinite;
  }
  @keyframes bss-bounce {
    0%, 100% { transform: translateY(0); opacity: 1; }
    50% { transform: translateY(5px); opacity: 0.35; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bss-hint-arrow { animation: none; }
  }

  /* BOOKS */
  .books-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }
  @media (max-width: 880px) {
    .books-grid { grid-template-columns: 1fr; gap: 3.5rem; }
  }

  .book-card {
    background: var(--bg-card);
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--line);
    transition: border-color 0.5s, transform 0.4s cubic-bezier(.2,.8,.2,1), box-shadow 0.5s;
    position: relative;
  }
  .book-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 18px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s;
    background: radial-gradient(600px circle at var(--mx, 50%) var(--my, 50%), rgba(255,255,255,0.05), transparent 40%);
    z-index: 1;
  }
  .book-card:hover::before { opacity: 1; }
  .book-card--signal:hover { border-color: rgba(45, 212, 191, 0.35); box-shadow: 0 25px 60px -20px rgba(45, 212, 191, 0.18); }
  .book-card--stille:hover { border-color: rgba(232, 169, 72, 0.32); box-shadow: 0 25px 60px -20px rgba(232, 169, 72, 0.18); }

  .cover {
    width: 100%;
    aspect-ratio: 1071 / 1700;
    display: block;
    overflow: hidden;
    position: relative;
    background: #060308;
    line-height: 0;
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s cubic-bezier(.2,.8,.2,1);
  }
  .book-card:hover .cover img { transform: scale(1.03); }

  .release-badge {
    position: absolute;
    top: 1.4rem;
    right: 1.4rem;
    width: 78px;
    height: 78px;
    border-radius: 50%;
    background: var(--gold);
    color: #0a0a0b;
    font-family: var(--sans);
    font-weight: 700;
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    line-height: 1.25;
    transform: rotate(8deg);
    z-index: 3;
    box-shadow: 0 6px 28px rgba(232, 169, 72, 0.5);
    pointer-events: none;
    user-select: none;
  }
  .badge-pre {
    font-size: 0.55rem;
    letter-spacing: 0.14em;
    opacity: 0.75;
  }
  .badge-date {
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }

  .book-info {
    padding: 1.75rem 1.75rem 2rem;
    position: relative;
    z-index: 2;
  }
  .book-tag {
    font-family: var(--mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    margin-bottom: 1rem;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .book-tag::before {
    content: '';
    width: 6px; height: 6px;
    border-radius: 50%;
  }
  .book-tag--signal { color: var(--teal); }
  .book-tag--signal::before { background: var(--teal); box-shadow: 0 0 12px var(--teal); }
  .book-tag--stille { color: var(--gold); }
  .book-tag--stille::before { background: var(--gold); box-shadow: 0 0 12px var(--gold); }

  .book-title {
    font-family: var(--serif);
    font-size: clamp(1.35rem, 2.4vw, 1.7rem);
    color: var(--text-heading);
    margin-bottom: 0.35rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.005em;
  }
  .book-subtitle {
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: 1.4rem;
    line-height: 1.4;
  }
  .book-desc {
    font-size: 0.95rem;
    color: var(--text);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  .book-meta {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: var(--text-dim);
    margin-bottom: 1.75rem;
    border-top: 1px solid var(--line);
    padding-top: 1.25rem;
  }
  .book-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  /* COUNTDOWN */
  .countdown {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
  }
  .countdown-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }
  .countdown-num {
    font-family: var(--mono);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--gold);
    line-height: 1;
    min-width: 2ch;
    text-align: center;
  }
  .countdown-label {
    font-family: var(--mono);
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-dim);
  }
  .countdown-done {
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--gold);
    margin-bottom: 1.75rem;
  }

  /* ABOUT */
  .about {
    max-width: 800px;
  }
  .about-lead {
    font-family: var(--serif);
    font-size: clamp(1.4rem, 2.6vw, 1.95rem);
    color: var(--text-heading);
    line-height: 1.4;
    margin-bottom: 2.5rem;
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  .about-lead em {
    font-style: italic;
    color: var(--gold);
  }
  .about p {
    font-size: 1.02rem;
    color: var(--text);
    line-height: 1.85;
    margin-bottom: 1.5rem;
    max-width: 680px;
  }
  .about p strong {
    color: var(--text-heading);
    font-weight: 500;
  }

  /* NEWSLETTER */
  .newsletter-inner { max-width: 560px; }
  .newsletter-headline {
    font-family: var(--serif);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    color: var(--text-heading);
    font-weight: 400;
    letter-spacing: -0.01em;
    margin-bottom: 0.75rem;
  }
  .newsletter-headline em {
    font-style: italic;
    color: var(--gold);
  }
  .newsletter-sub {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 1.75rem;
    max-width: 480px;
  }
  .newsletter-sub em {
    font-style: italic;
    color: var(--text);
  }
  .nl-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .nl-field {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .nl-input {
    flex: 1;
    min-width: 180px;
    background: var(--bg-card);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 0.85rem 1.25rem;
    color: var(--text-heading);
    font-family: var(--sans);
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.3s;
  }
  .nl-input::placeholder { color: var(--text-dim); }
  .nl-input:focus { border-color: var(--teal); }
  .nl-status {
    margin-top: 0.75rem;
    font-size: 0.88rem;
    min-height: 1.4em;
  }
  .nl-status--ok { color: var(--teal); }
  .nl-status--err { color: #f87171; }

  /* CONTACT / CTA */
  .contact {
    text-align: center;
    padding-bottom: 7rem;
  }
  .contact-headline {
    font-family: var(--serif);
    font-size: clamp(2rem, 5vw, 3.5rem);
    color: var(--text-heading);
    line-height: 1.1;
    margin-bottom: 1.5rem;
    font-weight: 400;
    letter-spacing: -0.015em;
  }
  .contact-headline em {
    font-style: italic;
    color: var(--teal);
  }
  .contact-sub {
    color: var(--text-muted);
    max-width: 460px;
