<script is:inline>
  // Shimmer + lift on book cards — no rotation so buttons stay stable
  const cards = document.querySelectorAll('[data-tilt]');
  cards.forEach(card => {
    card.addEventListener('mouseenter', () => {
      card.style.transform = 'translateY(-4px)';
    });
    card.addEventListener('mousemove', e => {
      const rect = card.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width;
      const y = (e.clientY - rect.top) / rect.height;
      card.style.setProperty('--mx', (x * 100) + '%');
      card.style.setProperty('--my', (y * 100) + '%');
    });
    card.addEventListener('mouseleave', () => {
      card.style.transform = '';
    });
  });

  // Newsletter-Formular
  (function() {
    var form = document.getElementById('nl-form');
    if (!form) return;
    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      var email = document.getElementById('nl-email').value.trim();
      var status = document.getElementById('nl-status');
      var btnLabel = document.getElementById('nl-btn-label');
      var btn = form.querySelector('button[type="submit"]');
      btn.disabled = true;
      btnLabel.textContent = '…';
      status.textContent = '';
      status.className = 'nl-status';
      try {
        var res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email })
        });
        var data = await res.json();
        if (data.ok) {
          form.querySelector('.nl-field').style.display = 'none';
          status.textContent = 'Danke — ich melde mich, sobald das Buch erschienen ist.';
          status.className = 'nl-status nl-status--ok';
        } else {
          status.textContent = data.error || 'Etwas ist schiefgelaufen.';
          status.className = 'nl-status nl-status--err';
          btn.disabled = false;
          btnLabel.textContent = 'Erinner mich';
        }
      } catch (_) {
        status.textContent = 'Netzwerkfehler — bitte später versuchen.';
        status.className = 'nl-status nl-status--err';
        btn.disabled = false;
        btnLabel.textContent = 'Erinner mich';
      }
    });
  })();

  // Countdown zum Release von "Du hörst es erst, wenn es still wird"
  (function() {
    var release = new Date('2026-05-30T00:00:00+02:00');
    var el = document.getElementById('countdown-stille');
    if (!el) return;
    function pad(n) { return String(n).padStart(2, '0'); }
    function tick() {
      var diff = release - Date.now();
      if (diff <= 0) {
        el.className = 'countdown-done';
        el.innerHTML = 'Jetzt erhältlich';
        return;
      }
      document.getElementById('cd-days').textContent  = pad(Math.floor(diff / 86400000));
      document.getElementById('cd-hours').textContent = pad(Math.floor(diff % 86400000 / 3600000));
      document.getElementById('cd-mins').textContent  = pad(Math.floor(diff % 3600000 / 60000));
      document.getElementById('cd-secs').textContent  = pad(Math.floor(diff % 60000 / 1000));
      setTimeout(tick, 1000);
    }
    tick();
  })();
</script>

</BaseLayout>
