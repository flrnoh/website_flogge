---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Florian Obermeier — Autor"
  description="Zwei Bücher, zwei Pole. Florian Obermeier schreibt über Technologie, die die Welt verändert — und über das, was unter dem Lärm liegt."
>

<style>
  /* HERO */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 6rem 2.5rem 4rem;
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
  }
  .hero-eyebrow {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: var(--teal);
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .hero-eyebrow::before {
    content: '';
    width: 28px;
    height: 1px;
    background: var(--teal);
  }
  .hero h1 {
    font-family: var(--serif);
    font-size: clamp(2.8rem, 9vw, 6.5rem);
    font-weight: 400;
    color: var(--text-heading);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 2rem;
  }
  .hero h1 .amp {
    font-style: italic;
    color: var(--text-muted);
    font-weight: 400;
    padding: 0 0.1em;
  }
  .hero h1 .stille {
    font-style: italic;
    background: linear-gradient(120deg, var(--gold) 30%, #f5d28e 70%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-sub {
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    color: var(--text);
    max-width: 600px;
    line-height: 1.7;
    margin-bottom: 3rem;
  }
  .hero-sub em {
    font-style: italic;
    color: var(--text-heading);
  }
  .hero-cta {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--text-heading);
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    transition: border-color 0.3s, background 0.3s, transform 0.3s;
    background: rgba(255,255,255,0.02);
  }
  .btn:hover {
    border-color: var(--teal);
    background: rgba(45, 212, 191, 0.08);
    transform: translateY(-1px);
  }
  .btn .arrow {
    transition: transform 0.3s;
  }
  .btn:hover .arrow { transform: translateX(3px); }
  .btn--ghost {
    border-color: transparent;
    background: transparent;
    color: var(--text-muted);
  }
  .btn--ghost:hover {
    color: var(--text-heading);
    border-color: var(--line-strong);
    background: transparent;
  }

  @media (max-width: 768px) {
    .hero { padding: 7rem 1.25rem 3rem; }
  }

  /* SECTION SHELL */
  section.block {
    padding: 7rem 2.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .section-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: var(--text-muted);
    margin-bottom: 3rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .section-label::before {
    content: '';
    width: 28px;
    height: 1px;
    background: var(--text-dim);
  }
  @media (max-width: 768px) {
    section.block { padding: 4.5rem 1.25rem; }
    .section-label { margin-bottom: 2rem; }
  }

  /* BOOKS */
  .books-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }
  @media (max-width: 880px) {
    .books-grid { grid-template-columns: 1fr; gap: 3.5rem; }
  }

  .book-card {
    background: var(--bg-card);
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--line);
    transition: border-color 0.5s, transform 0.4s cubic-bezier(.2,.8,.2,1), box-shadow 0.5s;
    position: relative;
  }
  .book-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 18px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s;
    background: radial-gradient(600px circle at var(--mx, 50%) var(--my, 50%), rgba(255,255,255,0.05), transparent 40%);
    z-index: 1;
  }
  .book-card:hover::before { opacity: 1; }
  .book-card--signal:hover { border-color: rgba(45, 212, 191, 0.35); box-shadow: 0 25px 60px -20px rgba(45, 212, 191, 0.18); }
  .book-card--stille:hover { border-color: rgba(232, 169, 72, 0.32); box-shadow: 0 25px 60px -20px rgba(232, 169, 72, 0.18); }

  .cover {
    width: 100%;
    aspect-ratio: 1071 / 1700;
    display: block;
    overflow: hidden;
    position: relative;
    background: #060308;
    line-height: 0;
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s cubic-bezier(.2,.8,.2,1);
  }
  .book-card:hover .cover img { transform: scale(1.03); }

  .release-badge {
    position: absolute;
    top: 1.4rem;
    right: 1.4rem;
    width: 78px;
    height: 78px;
    border-radius: 50%;
    background: var(--gold);
    color: #0a0a0b;
    font-family: var(--sans);
    font-weight: 700;
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    line-height: 1.25;
    transform: rotate(8deg);
    z-index: 3;
    box-shadow: 0 6px 28px rgba(232, 169, 72, 0.5);
    pointer-events: none;
    user-select: none;
  }
  .badge-pre {
    font-size: 0.55rem;
    letter-spacing: 0.14em;
    opacity: 0.75;
  }
  .badge-date {
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }

  .book-info {
    padding: 1.75rem 1.75rem 2rem;
    position: relative;
    z-index: 2;
  }
  .book-tag {
    font-family: var(--mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    margin-bottom: 1rem;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .book-tag::before {
    content: '';
    width: 6px; height: 6px;
    border-radius: 50%;
  }
  .book-tag--signal { color: var(--teal); }
  .book-tag--signal::before { background: var(--teal); box-shadow: 0 0 12px var(--teal); }
  .book-tag--stille { color: var(--gold); }
  .book-tag--stille::before { background: var(--gold); box-shadow: 0 0 12px var(--gold); }

  .book-title {
    font-family: var(--serif);
    font-size: clamp(1.35rem, 2.4vw, 1.7rem);
    color: var(--text-heading);
    margin-bottom: 0.35rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.005em;
  }
  .book-subtitle {
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: 1.4rem;
    line-height: 1.4;
  }
  .book-desc {
    font-size: 0.95rem;
    color: var(--text);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  .book-meta {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: var(--text-dim);
    margin-bottom: 1.75rem;
    border-top: 1px solid var(--line);
    padding-top: 1.25rem;
  }
  .book-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  /* ABOUT */
  .about {
    max-width: 800px;
  }
  .about-lead {
    font-family: var(--serif);
    font-size: clamp(1.4rem, 2.6vw, 1.95rem);
    color: var(--text-heading);
    line-height: 1.4;
    margin-bottom: 2.5rem;
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  .about-lead em {
    font-style: italic;
    color: var(--gold);
  }
  .about p {
    font-size: 1.02rem;
    color: var(--text);
    line-height: 1.85;
    margin-bottom: 1.5rem;
    max-width: 680px;
  }
  .about p strong {
    color: var(--text-heading);
    font-weight: 500;
  }

  /* CONTACT / CTA */
  .contact {
    text-align: center;
    padding-bottom: 7rem;
  }
  .contact-headline {
    font-family: var(--serif);
    font-size: clamp(2rem, 5vw, 3.5rem);
    color: var(--text-heading);
    line-height: 1.1;
    margin-bottom: 1.5rem;
    font-weight: 400;
    letter-spacing: -0.015em;
  }
  .contact-headline em {
    font-style: italic;
    color: var(--teal);
  }
  .contact-sub {
    color: var(--text-muted);
    max-width: 460px;
    margin: 0 auto 2.5rem;
    font-size: 1.05rem;
  }
  .contact-mail {
    font-family: var(--serif);
    font-size: clamp(1.2rem, 2.4vw, 1.7rem);
    color: var(--text-heading);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 0.35rem;
    transition: border-color 0.3s, color 0.3s;
    letter-spacing: -0.005em;
  }
  .contact-mail:hover {
    border-color: var(--teal);
    color: var(--teal);
  }
  .contact-socials {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-top: 2.5rem;
  }
</style>

<!-- HERO -->
<section class="hero">
  <p class="hero-eyebrow">Florian Obermeier — Autor</p>
  <h1>Signal<span class="amp"> &amp; </span><span class="stille">Stille</span></h1>
  <p class="hero-sub">Zwei Bücher, zwei Pole. Das eine erklärt eine Technologie, die die Welt verändert. Das andere sucht nach <em>dem, was darunter liegt</em>, wenn der Lärm verstummt.</p>
  <div class="hero-cta">
    <a href="#buecher" class="btn">Bücher entdecken <span class="arrow">→</span></a>
    <a href="#ueber" class="btn btn--ghost">Über mich</a>
  </div>
</section>

<!-- BOOKS -->
<section id="buecher" class="block">
  <p class="section-label reveal">Zwei Bücher</p>
  <div class="books-grid">

    <!-- BOOK 1: Signal -->
    <article class="book-card book-card--signal reveal" data-tilt>
      <div class="cover cover--ki">
        <img src="/cover-ki.jpg" alt="Cover: Warum KI kein Hype ist" width="1200" height="1905" loading="lazy" />
      </div>
      <div class="book-info">
        <p class="book-tag book-tag--signal">Signal — Sachbuch</p>
        <h2 class="book-title">Warum KI kein Hype ist</h2>
        <p class="book-subtitle">und wie sie unseren Alltag grundlegend verändert</p>
        <p class="book-desc">
          Vom Heizungsbauer zum KI-Buch. Florian Obermeier erklärt Künstliche Intelligenz so, wie er sie selbst entdeckt hat — ohne Mathematik, ohne Magie, aber mit klarem Blick. Eine Landkarte für alle, die verstehen wollen, was gerade passiert, und für jene, die nicht zuschauen, sondern mitgestalten wollen.
        </p>
        <p class="book-meta">2025 · 586 Seiten · BoD · ISBN 978-3-6951-7324-2</p>
        <div class="book-actions">
          <a href="https://www.amazon.de/Warum-kein-Hype-ist-grundlegend/dp/3695173246" class="btn" target="_blank" rel="noopener">Bei Amazon <span class="arrow">↗</span></a>
          <a href="https://buchshop.bod.de/warum-ki-kein-hype-ist-florian-obermeier-9783695173242" class="btn btn--ghost" target="_blank" rel="noopener">BoD ↗</a>
        </div>
      </div>
    </article>

    <!-- BOOK 2: Stille -->
    <article class="book-card book-card--stille reveal" data-tilt>
      <div class="cover">
        <img src="/cover-stille.jpg" alt="Cover: Du hörst es erst, wenn es still wird" width="1071" height="1700" loading="lazy" />
        <div class="release-badge" aria-label="Erscheint 30. Mai">
          <span class="badge-pre">AB</span>
          <span class="badge-date">30. MAI</span>
        </div>
      </div>
      <div class="book-info">
        <p class="book-tag book-tag--stille">Stille — Memoir mit Soundtrack</p>
        <h2 class="book-title">Du hörst es erst, wenn es still wird</h2>
        <p class="book-subtitle">Ein Buch mit Soundtrack</p>
        <p class="book-desc">
          Alles lief. Der Job, der Kalender, die Rolle, in der niemand auf die Idee käme zu fragen. Bis der Körper anfängt, Dinge zu tun, die sich nicht mehr erklären lassen. Ein Protokoll des Wegs durch die Stille — und ein Soundtrack, der dort weitermacht, wo Worte an ihre Grenze kommen. Zu jedem der 13 Kapitel ein eigener Song. QR‑Code, Klick, direkt zum Track.
        </p>
        <p class="book-meta">Erscheint 30. Mai 2026 · 13 Kapitel · 13 Songs · BoD</p>
        <div class="book-actions">
          <a href="mailto:kontakt@florian-obermeier.com?subject=Du%20h%C3%B6rst%20es%20erst%2C%20wenn%20es%20still%20wird" class="btn">Anfragen <span class="arrow">→</span></a>
          <a href="https://suno.com/playlist/bf894a62-55e4-4b09-8c5e-211793d0614d" class="btn btn--ghost" target="_blank" rel="noopener">Zum Soundtrack ↗</a>
        </div>
      </div>
    </article>

  </div>
</section>

<!-- ABOUT -->
<section id="ueber" class="block">
  <p class="section-label reveal">Über</p>
  <div class="about">
    <p class="about-lead reveal">
      Florian Obermeier lebt im Bayerischen Wald — dort, wo die Hügel den Blick beruhigen und Funklöcher schneller über Telefonate entscheiden als man selbst. Ein guter Ort zum <em>Nachdenken</em>.
    </p>
    <p class="reveal">
      Seine Reise begann nicht in einem Tech‑Studium, sondern auf Baustellen und in Werkstätten — als <strong>Heizungsbauer und Fliesenleger</strong>. Über den Bachelor Professional of Technical Management ging es weiter in Beratung und Strategiearbeit. Als zertifizierter LEGO® SERIOUS PLAY®‑Facilitator macht er heute Denkweisen sichtbar, die sich nicht in Folien zeigen lassen.
    </p>
    <p class="reveal">
      Ende 2022 öffnete er ChatGPT mit geringen Erwartungen — und wusste nach wenigen Minuten, dass sich etwas Fundamentales verändert hat. Ein Besuch im <strong>Silicon Valley 2024</strong> machte aus der Ahnung Gewissheit. Daraus entstand sein erstes Buch.
    </p>
    <p class="reveal">
      Zwischen den beiden Polen — laut und leise, Code und Körper, Signal und Stille — bewegen sich seine Texte. Das zweite Buch ist die andere Seite davon: ein Protokoll dessen, was unter dem Lärm liegt, wenn er endlich verstummt.
    </p>
  </div>
</section>

<!-- CONTACT -->
<section id="kontakt" class="block contact">
  <h2 class="contact-headline reveal">Sag <em>Hallo</em>.</h2>
  <p class="contact-sub reveal">Lesungen, Interviews, Workshops, Kooperationen — oder einfach ein paar Zeilen.</p>
  <a href="mailto:kontakt@florian-obermeier.com" class="contact-mail reveal">kontakt@florian-obermeier.com</a>
  <div class="contact-socials reveal">
    <a href="https://www.linkedin.com/in/florian-obermeier/" class="btn btn--ghost" target="_blank" rel="noopener">LinkedIn ↗</a>
    <a href="https://www.instagram.com/flrn.oh" class="btn btn--ghost" target="_blank" rel="noopener">Instagram ↗</a>
  </div>
</section>

<script is:inline>
  // Shimmer + lift on book cards — no rotation so buttons stay stable
  const cards = document.querySelectorAll('[data-tilt]');
  cards.forEach(card => {
    card.addEventListener('mouseenter', () => {
      card.style.transform = 'translateY(-4px)';
    });
    card.addEventListener('mousemove', e => {
      const rect = card.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width;
      const y = (e.clientY - rect.top) / rect.height;
      card.style.setProperty('--mx', (x * 100) + '%');
      card.style.setProperty('--my', (y * 100) + '%');
    });
    card.addEventListener('mouseleave', () => {
      card.style.transform = '';
    });
  });
</script>

</BaseLayout>
