<script is:inline>
  // Shimmer + lift on book cards
  const cards = document.querySelectorAll('[data-tilt]');
  cards.forEach(card => {
    card.addEventListener('mouseenter', () => {
      card.style.transform = 'translateY(-4px)';
    });
    card.addEventListener('mousemove', e => {
      const rect = card.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width;
      const y = (e.clientY - rect.top) / rect.height;
      card.style.setProperty('--mx', (x * 100) + '%');
      card.style.setProperty('--my', (y * 100) + '%');
    });
    card.addEventListener('mouseleave', () => {
      card.style.transform = '';
    });
  });

  // Audio players (foreword + soundtrack) — generic, supports multiple players
  (function() {
    var players = document.querySelectorAll('.player');
    if (!players.length) return;

    function fmt(sec) {
      if (!isFinite(sec)) return '--:--';
      var m = Math.floor(sec / 60);
      var s = Math.floor(sec % 60);
      return m + ':' + (s < 10 ? '0' + s : s);
    }

    players.forEach(function(player) {
      var audio = player.querySelector('audio');
      var btn = player.querySelector('.player-btn');
      var progress = player.querySelector('.player-progress');
      var fill = player.querySelector('.player-progress-fill');
      var timeCurrent = player.querySelector('.player-time-current');
      var timeTotal = player.querySelector('.player-time-total');
      if (!audio || !btn || !progress) return;

      var labelPlay = player.getAttribute('data-label-play') || 'Play';
      var labelPause = player.getAttribute('data-label-pause') || 'Pause';
      var trackType = player.getAttribute('data-track-type') || 'audio';
      var trackName = player.getAttribute('data-track-name') || '';
      var trackChapter = player.getAttribute('data-track-chapter');
      var trackData = { name: trackName };
      if (trackChapter) trackData.chapter = parseInt(trackChapter, 10);
      var playTracked = false;

      function vaTrack(suffix) {
        if (typeof window.va === 'function') {
          try { window.va('event', { name: trackType + '_' + suffix, data: trackData }); } catch (e) {}
        }
      }
      function seekFromEvent(e) {
        if (!audio.duration) return;
        var rect = progress.getBoundingClientRect();
        var pct = (e.clientX - rect.left) / rect.width;
        pct = pct < 0 ? 0 : pct > 1 ? 1 : pct;
        audio.currentTime = pct * audio.duration;
      }

      btn.addEventListener('click', function() {
        if (audio.paused) { audio.play(); } else { audio.pause(); }
      });
      audio.addEventListener('play', function() {
        // Pause any other player that's currently playing
        players.forEach(function(other) {
          if (other !== player) {
            var otherAudio = other.querySelector('audio');
            if (otherAudio && !otherAudio.paused) otherAudio.pause();
          }
        });
        player.classList.add('is-playing');
        btn.setAttribute('aria-label', labelPause);
        if (!playTracked) {
          playTracked = true;
          vaTrack('play');
        }
      });
      audio.addEventListener('pause', function() {
        player.classList.remove('is-playing');
        btn.setAttribute('aria-label', labelPlay);
      });
      audio.addEventListener('ended', function() {
        player.classList.remove('is-playing');
        btn.setAttribute('aria-label', labelPlay);
        if (fill) fill.style.width = '0%';
        if (timeCurrent) timeCurrent.textContent = '0:00';
        progress.setAttribute('aria-valuenow', '0');
        vaTrack('complete');
      });
      audio.addEventListener('loadedmetadata', function() {
        if (timeTotal) timeTotal.textContent = fmt(audio.duration);
      });
      audio.addEventListener('timeupdate', function() {
        if (!audio.duration) return;
        var pct = audio.currentTime / audio.duration * 100;
        if (fill) fill.style.width = pct + '%';
        if (timeCurrent) timeCurrent.textContent = fmt(audio.currentTime);
        progress.setAttribute('aria-valuenow', String(Math.round(pct)));
      });
      progress.addEventListener('click', seekFromEvent);
      progress.addEventListener('keydown', function(e) {
        if (!audio.duration) return;
        if (e.key === 'ArrowRight') { audio.currentTime = Math.min(audio.duration, audio.currentTime + 5); e.preventDefault(); }
        if (e.key === 'ArrowLeft')  { audio.currentTime = Math.max(0, audio.currentTime - 5); e.preventDefault(); }
        if (e.key === ' ' || e.key === 'Enter') {
          if (audio.paused) { audio.play(); } else { audio.pause(); }
          e.preventDefault();
        }
      });
    });
  })();
</script>

