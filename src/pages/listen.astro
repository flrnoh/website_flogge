---
// Vanity URL for sharing on Insta stories, in bio, in DMs etc.
// Redirects to the soundtrack section on the English homepage.

const dest = '/en/#soundtrack';
const title = 'Listen in — Foreword & Soundtrack';
const description = "The foreword and first song from 'You Only Hear It When It Falls Silent' — read by the author, composed with Suno.";
const site = Astro.site ?? 'https://florian-obermeier.com';
const canonical = new URL(dest, site).toString();
const shareUrl = new URL('/listen', site).toString();
const ogImage = new URL('/og-image.png', site).toString();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Florian Obermeier</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex,follow" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={shareUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="en_US" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <meta http-equiv="refresh" content="0;url=/en/#soundtrack" />
  <script is:inline>location.replace('/en/#soundtrack');</script>

  <style>
    body { background:#0a0a0b; color:#d4d4d8; font-family: system-ui, -apple-system, sans-serif; padding: 4rem 1.5rem; text-align:center; line-height:1.7; }
    a { color:#e8a948; }
  </style>
</head>
<body>
  <p>If you are not redirected automatically, the player is <a href={dest}>here</a>.</p>
</body>
</html>
