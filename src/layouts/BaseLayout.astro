---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/playfair-display/400.css';
import '@fontsource/playfair-display/400-italic.css';
import '@fontsource/playfair-display/500.css';
import '@fontsource/playfair-display/700.css';

interface Props {
  title: string;
  description?: string;
  pageType?: 'home' | 'legal' | 'page';
  lang?: 'de' | 'en';
  alternateUrl?: string;
  /** Keep the page out of search results while leaving it reachable by URL. */
  noindex?: boolean;
}

const {
  title,
  description = 'Florian Obermeier — Autor. Zwei Bücher, zwei Pole. Das eine erklärt eine Technologie, die die Welt verändert. Das andere sucht nach dem, was darunter liegt.',
  pageType = 'home',
  lang = 'de',
  alternateUrl,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://florian-obermeier.com').toString();
const ogImage = new URL('/og-image.png', Astro.site ?? 'https://florian-obermeier.com').toString();
const ogLocale = lang === 'en' ? 'en_US' : 'de_DE';
const year = new Date().getFullYear();

const t = lang === 'en'
  ? {
      navBooks: 'Books',
      navAbout: 'About',
      navContact: 'Contact',
      footerTagline: 'Two books, two poles. Signal and Stille.',
      footerImpressum: 'Imprint',
      footerDatenschutz: 'Privacy',
    }
  : {
      navBooks: 'Bücher',
      navAbout: 'Über',
      navContact: 'Kontakt',
      footerTagline: 'Zwei Bücher, zwei Pole. Signal und Stille.',
      footerImpressum: 'Impressum',
      footerDatenschutz: 'Datenschutz',
    };

const homeUrl = lang === 'en' ? '/en/' : '/';
const navPrefix = pageType === 'home' ? '' : homeUrl;

// Language switch: stay on the current page's translation when the page has
// one (alternateUrl), instead of always bouncing back to the homepage.
const deUrl = lang === 'de' ? Astro.url.pathname : (alternateUrl ?? '/');
const enUrl = lang === 'en' ? Astro.url.pathname : (alternateUrl ?? '/en/');
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex,follow" />}
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" href="/sitemap.xml" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  {alternateUrl && lang === 'de' && (
    <>
      <link rel="alternate" hreflang="de" href={new URL('/', Astro.site ?? 'https://florian-obermeier.com').toString()} />
      <link rel="alternate" hreflang="en" href={new URL(alternateUrl, Astro.site ?? 'https://florian-obermeier.com').toString()} />
      <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site ?? 'https://florian-obermeier.com').toString()} />
    </>
  )}
  {alternateUrl && lang === 'en' && (
    <>
      <link rel="alternate" hreflang="de" href={new URL(alternateUrl, Astro.site ?? 'https://florian-obermeier.com').toString()} />
      <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site ?? 'https://florian-obermeier.com').toString()} />
      <link rel="alternate" hreflang="x-default" href={new URL(alternateUrl, Astro.site ?? 'https://florian-obermeier.com').toString()} />
    </>
  )}

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content={ogLocale} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <style is:global>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --teal: #2dd4bf;
      --teal-soft: rgba(45, 212, 191, 0.18);
      --teal-glow: rgba(45, 212, 191, 0.08);
      --gold: #e8a948;
      --gold-soft: rgba(232, 169, 72, 0.16);
      --gold-glow: rgba(232, 169, 72, 0.06);
      --bg: #0a0a0b;
      --bg-elev: #111114;
      --bg-card: #131318;
      --line: rgba(255, 255, 255, 0.06);
      --line-strong: rgba(255, 255, 255, 0.12);
      --text: #d4d4d8;
      --text-muted: #71717a;
      --text-dim: #52525b;
      --text-heading: #fafafa;
      --serif: 'Playfair Display', serif;
      --sans: 'Inter', system-ui, -apple-system, sans-serif;
      --mono: ui-monospace, 'SF Mono', Menlo, monospace;
    }

    html {
      /* scroll-behavior: smooth is enabled via JS after page load.
         Reason: deep-links like /#soundtrack would otherwise smooth-scroll
         through the 340vh book-flip animation, firing its scroll handler
         many times mid-flight and visibly juddering. Initial hash-scroll
         stays instant; subsequent in-page nav clicks become smooth. */
      scroll-padding-top: 96px; /* keep anchor targets clear of fixed nav */
      background: var(--bg);
    }

    body {
      font-family: var(--sans);
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
      min-height: 100vh;
    }

    /* Film grain overlay — adds tactile mood */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 1;
      opacity: 0.035;
      mix-blend-mode: overlay;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)' opacity='1'/></svg>");
    }

    /* Ambient gradient orbs in the background */
    body::after {
      content: '';
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background:
        radial-gradient(800px 600px at 15% 20%, var(--teal-glow), transparent 60%),
        radial-gradient(700px 500px at 85% 80%, var(--gold-glow), transparent 60%);
    }

    main, nav, footer { position: relative; z-index: 2; }

    a { color: inherit; }

    ::selection { background: var(--teal); color: var(--bg); }

    /* Reading progress */
    .progress {
      position: fixed;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: transparent;
      z-index: 200;
      pointer-events: none;
    }
    .progress-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, var(--teal), var(--gold));
      transition: width 80ms linear;
    }

    /* Navigation */
    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.25rem 2.5rem;
      z-index: 100;
      background: rgba(10, 10, 11, 0.65);
      backdrop-filter: saturate(180%) blur(20px);
      -webkit-backdrop-filter: saturate(180%) blur(20px);
      border-bottom: 1px solid transparent;
      transition: border-color 0.3s, padding 0.3s;
    }
    nav.is-scrolled {
      border-bottom-color: var(--line);
      padding-top: 1rem;
      padding-bottom: 1rem;
    }
    .nav-name {
      font-family: var(--serif);
      font-size: 1.05rem;
      color: var(--text-heading);
      text-decoration: none;
      letter-spacing: 0.01em;
      font-weight: 500;
    }
    .nav-right {
      display: flex;
      align-items: center;
      gap: 2rem;
    }
    .nav-links {
      list-style: none;
      display: flex;
      gap: 2.25rem;
    }
    .nav-links a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.78rem;
      font-weight: 400;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      transition: color 0.3s;
      position: relative;
    }
    .nav-links a:hover { color: var(--text-heading); }
    .nav-links a::after {
      content: '';
      position: absolute;
      left: 0; right: 0; bottom: -6px;
      height: 1px;
      background: var(--teal);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.3s cubic-bezier(.2,.8,.2,1);
    }
    .nav-links a:hover::after { transform: scaleX(1); }

    .lang-switch {
      display: flex;
      align-items: center;
      gap: 0.3rem;
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.14em;
      border-left: 1px solid var(--line-strong);
      padding-left: 1.5rem;
    }
    .lang-btn {
      color: var(--text-muted);
      text-decoration: none;
      transition: color 0.3s;
    }
    .lang-btn:hover { color: var(--text-heading); }
    .lang-btn--active {
      color: var(--text-heading);
      pointer-events: none;
    }
    .lang-sep { color: var(--text-dim); }

    @media (max-width: 768px) {
      nav { padding: 1rem 1.25rem; }
      .nav-right { gap: 1rem; }
      .nav-links { gap: 1.1rem; }
      .nav-links a { font-size: 0.7rem; letter-spacing: 0.12em; }
      .lang-switch { padding-left: 1rem; }
    }


    /* Footer */
    footer {
      padding: 5rem 2.5rem 3rem;
      max-width: 1200px;
      margin: 0 auto;
      border-top: 1px solid var(--line);
    }
    .footer-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: flex-start;
    }
    .footer-mark {
      font-family: var(--serif);
      font-size: 1.4rem;
      color: var(--text-heading);
      margin-bottom: 0.4rem;
    }
    .footer-tagline {
      font-size: 0.85rem;
      color: var(--text-muted);
      max-width: 360px;
    }
    .footer-contact {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      font-size: 0.85rem;
    }
    .footer-contact a {
      color: var(--text);
      text-decoration: none;
      transition: color 0.3s;
    }
    .footer-contact a:hover { color: var(--teal); }
    .footer-meta {
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 1px solid var(--line);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .footer-legal {
      list-style: none;
      display: flex;
      gap: 1.5rem;
    }
    .footer-legal a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.78rem;
      letter-spacing: 0.05em;
      transition: color 0.3s;
    }
    .footer-legal a:hover { color: var(--text-heading); }
    .footer-copy {
      color: var(--text-dim);
      font-size: 0.75rem;
      letter-spacing: 0.02em;
    }

    @media (max-width: 720px) {
      footer { padding: 4rem 1.25rem 2rem; }
      .footer-grid { grid-template-columns: 1fr; gap: 2rem; }
      .footer-meta { flex-direction: column; align-items: flex-start; gap: 1rem; }
    }

    /* Reveal on scroll */
    .reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.9s cubic-bezier(.2,.8,.2,1), transform 0.9s cubic-bezier(.2,.8,.2,1);
    }
    .reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
      .reveal { opacity: 1; transform: none; transition: none; }
      html { scroll-behavior: auto; }
      body::before { display: none; }
    }
  </style>
</head>
<body>

<div class="progress"><div class="progress-fill" id="progressFill"></div></div>

<nav id="nav">
  <a href={homeUrl} class="nav-name">Florian Obermeier</a>
  <div class="nav-right">
    <ul class="nav-links">
      {pageType === 'home' ? (
        <>
          <li><a href="#buecher">{t.navBooks}</a></li>
          <li><a href="#ueber">{t.navAbout}</a></li>
          <li><a href="#kontakt">{t.navContact}</a></li>
        </>
      ) : (
        <>
          <li><a href={`${homeUrl}#buecher`}>{t.navBooks}</a></li>
          <li><a href={`${homeUrl}#ueber`}>{t.navAbout}</a></li>
          <li><a href={`${homeUrl}#kontakt`}>{t.navContact}</a></li>
        </>
      )}
    </ul>
    <div class="lang-switch" aria-label="Language">
      <a href={deUrl} class:list={['lang-btn', { 'lang-btn--active': lang === 'de' }]}>DE</a>
      <span class="lang-sep" aria-hidden="true">/</span>
      <a href={enUrl} class:list={['lang-btn', { 'lang-btn--active': lang === 'en' }]}>EN</a>
    </div>
  </div>
</nav>

<main>
  <slot />
</main>

<footer>
  <div class="footer-grid">
    <div>
      <p class="footer-mark">Florian Obermeier</p>
      <p class="footer-tagline">{t.footerTagline}</p>
    </div>
    <div class="footer-contact">
      <a href="mailto:kontakt@florian-obermeier.com">kontakt@florian-obermeier.com</a>
      <a href="https://www.linkedin.com/in/florian-obermeier/" target="_blank" rel="noopener">LinkedIn ↗</a>
      <a href="https://www.instagram.com/flrn.oh" target="_blank" rel="noopener">Instagram ↗</a>
    </div>
  </div>
  <div class="footer-meta">
    <p class="footer-copy">© {year} Florian Obermeier</p>
    <ul class="footer-legal">
      <li><a href="/impressum">{t.footerImpressum}</a></li>
      <li><a href="/datenschutz">{t.footerDatenschutz}</a></li>
    </ul>
  </div>
</footer>

<script is:inline>
  // Reading progress
  const fill = document.getElementById('progressFill');
  const nav = document.getElementById('nav');
  function updateProgress() {
    const doc = document.documentElement;
    const total = doc.scrollHeight - window.innerHeight;
    const pct = total > 0 ? (window.scrollY / total) * 100 : 0;
    if (fill) fill.style.width = pct + '%';
    if (nav) nav.classList.toggle('is-scrolled', window.scrollY > 16);
  }
  document.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();

  // If page loaded with a hash pointing at a section, reveal that
  // section's contents immediately so deep-links (e.g. Insta story
  // sharing #soundtrack) don't show empty space before observer fires.
  if (location.hash && location.hash.length > 1) {
    try {
      const hashTarget = document.querySelector(location.hash);
      if (hashTarget) {
        hashTarget.querySelectorAll('.reveal').forEach(el => el.classList.add('is-visible'));
        if (hashTarget.classList && hashTarget.classList.contains('reveal')) {
          hashTarget.classList.add('is-visible');
        }
      }
    } catch (e) { /* invalid selector — ignore */ }
  }

  // Enable smooth scroll only after initial load + first paint. This way
  // the browser's automatic hash-scroll on load is instant (no judder
  // through scroll-driven animations), but subsequent in-page nav clicks
  // (#buecher, #ueber, #kontakt) animate smoothly.
  window.addEventListener('load', () => {
    requestAnimationFrame(() => {
      document.documentElement.style.scrollBehavior = 'smooth';
    });
  });

  // Reveal observer
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('is-visible');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
</script>

<Analytics />
<SpeedInsights />
</body>
</html>
