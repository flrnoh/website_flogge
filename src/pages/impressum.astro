---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Impressum — Florian Obermeier"
  description="Impressum gemäß § 5 TMG und § 18 Abs. 2 MStV."
  pageType="legal"
>

<style>
  .legal {
    max-width: 760px;
    margin: 0 auto;
    padding: 9rem 2.5rem 5rem;
  }
  .legal h1 {
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--text-heading);
    font-weight: 400;
    letter-spacing: -0.015em;
    margin-bottom: 0.5rem;
  }
  .legal-eyebrow {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }
  .legal h2 {
    font-family: var(--serif);
    font-size: 1.25rem;
    color: var(--text-heading);
    font-weight: 500;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.005em;
  }
  .legal p, .legal address, .legal li {
    font-size: 0.97rem;
    line-height: 1.75;
    color: var(--text);
    margin-bottom: 0.5rem;
  }
  .legal address {
    font-style: normal;
  }
  .legal a {
    color: var(--text-heading);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    transition: border-color 0.3s, color 0.3s;
  }
  .legal a:hover { border-color: var(--teal); color: var(--teal); }
  .legal ul {
    list-style: none;
    padding-left: 0;
  }
  .legal .small {
    color: var(--text-muted);
    font-size: 0.85rem;
  }
  @media (max-width: 720px) {
    .legal { padding: 7rem 1.25rem 4rem; }
  }
</style>

<article class="legal">
  <p class="legal-eyebrow">Rechtliches</p>
  <h1>Impressum</h1>

  <h2>Angaben gemäß § 5 TMG</h2>
  <address>
    Florian Obermeier<br />
    Linprunstraße 9<br />
    94234 Viechtach<br />
    Deutschland
  </address>

  <h2>Kontakt</h2>
  <ul>
    <li>E‑Mail: <a href="mailto:kontakt@florian-obermeier.com">kontakt@florian-obermeier.com</a></li>
  </ul>

  <h2>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
  <address>
    Florian Obermeier<br />
    Linprunstraße 9<br />
    94234 Viechtach
  </address>

