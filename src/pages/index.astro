<script is:inline>
  // Shimmer + lift on book cards — no rotation so buttons stay stable
  const cards = document.querySelectorAll('[data-tilt]');
  cards.forEach(card => {
    card.addEventListener('mouseenter', () => {
      card.style.transform = 'translateY(-4px)';
    });
    card.addEventListener('mousemove', e => {
      const rect = card.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width;
      const y = (e.clientY - rect.top) / rect.height;
      card.style.setProperty('--mx', (x * 100) + '%');
      card.style.setProperty('--my', (y * 100) + '%');
    });
    card.addEventListener('mouseleave', () => {
      card.style.transform = '';
    });
  });

  // Anmeldung — Submit direkt an Brevo (no-cors), Inline-Bestätigung.
  // Ohne JS greift der normale Form-POST auf die Brevo-Bestätigungsseite.
  (function() {
    var form = document.getElementById('nl-form');
    if (!form) return;
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var status = document.getElementById('nl-status');
      var btnLabel = document.getElementById('nl-btn-label');
      var btn = form.querySelector('button[type="submit"]');
      btn.disabled = true;
      btnLabel.textContent = '…';
      fetch(form.action, {
        method: 'POST',
        mode: 'no-cors',
        body: new URLSearchParams(new FormData(form))
      }).finally(function() {
        form.querySelector('.nl-field').style.display = 'none';
        status.textContent = 'Danke — ich melde mich, sobald das Buch erschienen ist.';
        status.className = 'nl-status nl-status--ok';
      });
    });
  })();

  // Countdown zum Release von "Du hörst es erst, wenn es still wird"
  (function() {
    var release = new Date('2026-05-30T00:00:00+02:00');
    var el = document.getElementById('countdown-stille');
    if (!el) return;
    function pad(n) { return String(n).padStart(2, '0'); }
    function tick() {
      var diff = release - Date.now();
      if (diff <= 0) {
        el.className = 'countdown-done';
        el.innerHTML = 'Jetzt erhältlich';
        return;
      }
      document.getElementById('cd-days').textContent  = pad(Math.floor(diff / 86400000));
      document.getElementById('cd-hours').textContent = pad(Math.floor(diff % 86400000 / 3600000));
      document.getElementById('cd-mins').textContent  = pad(Math.floor(diff % 3600000 / 60000));
      document.getElementById('cd-secs').textContent  = pad(Math.floor(diff % 60000 / 1000));
      setTimeout(tick, 1000);
    }
    tick();
  })();
</script>

<script is:inline>
(function () {
  var wrap = document.getElementById('bssWrap');
  var book = document.getElementById('bssBook');
  var cover = document.getElementById('bssCover');
  var leftPage = document.getElementById('bssLeftPage');
  var meta = document.getElementById('bssMeta');
  var hint = document.getElementById('bssHint');
  if (!wrap || !book || !cover) return;

  function clamp(v, lo, hi) { return v < lo ? lo : v > hi ? hi : v; }
  function lerp(a, b, t) { return a + (b - a) * t; }
  function ease(t) { return t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t; }
  function easeSlow(t) { return 1 - Math.pow(1 - t, 3); }

  function getProgress() {
    var rect = wrap.getBoundingClientRect();
    var scrollable = wrap.offsetHeight - window.innerHeight;
    return clamp(-rect.top / scrollable, 0, 1);
  }

  var lastP = -1;
  function update() {
    var p = getProgress();
    if (Math.abs(p - lastP) < 0.0005) return;
    lastP = p;

    /* Phase 1: entrance  0 → 0.18 */
    var entT = ease(clamp(p / 0.18, 0, 1));
    var entY = lerp(55, 0, entT);
    var entScale = lerp(0.88, 1, entT);
    var entOpacity = entT;

    /* Phase 2: cover opens  0.18 → 0.68 */
    var openT = easeSlow(clamp((p - 0.18) / 0.5, 0, 1));
    var coverAngle = lerp(0, -178, openT);

    /* slight book tilt: angled when closed, flatter when open */
    var tiltY = lerp(-26, -6, openT);
    var tiltX = lerp(5, 2, openT);

    book.style.opacity = entOpacity;
    book.style.transform =
      'translateY(' + entY + 'px) scale(' + entScale + ') ' +
      'rotateX(' + tiltX + 'deg) rotateY(' + tiltY + 'deg)';

    cover.style.transform = 'rotateY(' + coverAngle + 'deg)';

    /* left page fades in as cover swings past ~60 % */
    var leftOpacity = ease(clamp((openT - 0.55) / 0.45, 0, 1));
    leftPage.style.opacity = leftOpacity;

    /* Phase 3: meta / CTA  0.65 → 0.82 */
    var metaT = ease(clamp((p - 0.65) / 0.17, 0, 1));
    if (metaT > 0.05) {
      meta.classList.add('is-visible');
    } else {
      meta.classList.remove('is-visible');
    }

    /* Scroll hint fades out early */
    if (hint) hint.style.opacity = clamp(1 - p / 0.12, 0, 1);
  }

  document.addEventListener('scroll', update, { passive: true });
  update();
})();
</script>

